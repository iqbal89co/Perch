<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Perch</AssemblyName>
    <RootNamespace>Perch</RootNamespace>
    <ApplicationIcon>Assets\perch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Perch</Product>
    <Company>Perch</Company>
    <Description>Perch - a living island for the top of your screen</Description>
    <Copyright>Copyright (C) 2026</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- DPI awareness is declared in app.manifest on purpose (WPF needs PerMonitorV2 there). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon and screen enumeration; keep its types out of global usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\perch.ico" />
    <Resource Include="Assets\perch.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Perch.Tests" />
  </ItemGroup>

</Project>
