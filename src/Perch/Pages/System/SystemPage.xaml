<core:IslandPage x:Class="Perch.Pages.SystemMonitor.SystemPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core"
                 xmlns:local="clr-namespace:Perch.Pages.SystemMonitor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
        </Grid.RowDefinitions>

        <!-- Row 1: CPU, GPU, memory and power. The GPU tile goes when the GPU counters do not exist. -->
        <Grid x:Name="TopRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="GpuColumn" Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="CPU" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="CpuValue" Grid.Row="1" Style="{StaticResource PerchTitle}" FontSize="22" Margin="0,1,0,0" Text="--" />
                    <TextBlock x:Name="CpuDetail" Grid.Row="2" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                    <local:Sparkline x:Name="CpuSpark" Grid.Row="3" MinHeight="16" Margin="0,4,0,0"
                                     Stroke="{DynamicResource IslandAccent}" />
                </Grid>
            </Border>

            <!-- GPU -->
            <Border x:Name="GpuCard" Style="{StaticResource PerchCard}" Padding="10,8,10,6" Margin="0,0,8,0" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="GPU" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="GpuValue" Grid.Row="1" Style="{StaticResource PerchTitle}" FontSize="22" Margin="0,1,0,0" Text="--" />
                    <TextBlock x:Name="GpuDetail" Grid.Row="2" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                    <local:Sparkline x:Name="GpuSpark" Grid.Row="3" MinHeight="16" Margin="0,4,0,0"
                                     Stroke="{DynamicResource IslandAccent}" />
                </Grid>
            </Border>

            <!-- Memory -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Margin="0,0,8,0" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="MEMORY" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="MemValue" Grid.Row="1" Style="{StaticResource PerchTitle}" FontSize="22" Margin="0,1,0,0" Text="--" />
                    <TextBlock x:Name="MemDetail" Grid.Row="2" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                    <local:Sparkline x:Name="MemSpark" Grid.Row="3" MinHeight="16" Margin="0,4,0,0"
                                     Stroke="{DynamicResource IslandAccent}" />
                </Grid>
            </Border>

            <!-- Power -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Grid.Column="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="POWER" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="PowerValue" Grid.Row="1" Style="{StaticResource PerchTitle}" FontSize="22" Margin="0,1,0,0" Text="--" />
                    <TextBlock x:Name="PowerDetail" Grid.Row="2" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                    <local:Sparkline x:Name="PowerSpark" Grid.Row="3" MinHeight="16" Margin="0,4,0,0"
                                     Stroke="{DynamicResource IslandAccent}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: network, disks and top processes -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Network -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="NETWORK" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="DownText" Grid.Row="1" Margin="0,3,0,0" Style="{StaticResource PerchBody}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandAccent}" />
                    <TextBlock x:Name="UpText" Grid.Row="2" Style="{StaticResource PerchBody}" FontSize="12" Foreground="{DynamicResource IslandSubtle}" />
                    <TextBlock x:Name="NetDetail" Grid.Row="3" Style="{StaticResource PerchCaption}" FontSize="10.5" Margin="0,3,0,0" />
                    <TextBlock x:Name="NetTotals" Grid.Row="4" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                    <Grid Grid.Row="5" Margin="0,4,0,0">
                        <local:Sparkline x:Name="UpSpark" Stroke="{DynamicResource IslandSubtle}" />
                        <local:Sparkline x:Name="DownSpark" Stroke="{DynamicResource IslandAccent}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Disks -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Margin="0,0,8,0" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="DISKS" FontSize="10.5" FontWeight="SemiBold" />
                    <StackPanel x:Name="DiskList" Grid.Row="1" Margin="0,4,0,0" />
                    <TextBlock x:Name="DiskHint" Grid.Row="1" Style="{StaticResource PerchCaption}" FontSize="11" Margin="0,4,0,0"
                               Text="No fixed drives" Visibility="Collapsed" />
                    <TextBlock x:Name="DiskIoText" Grid.Row="2" Style="{StaticResource PerchCaption}" FontSize="10.5" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- Top processes -->
            <Border Style="{StaticResource PerchCard}" Padding="10,8,10,6" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PerchCaption}" Text="TOP PROCESSES" FontSize="10.5" FontWeight="SemiBold" />
                    <StackPanel x:Name="ProcessList" Grid.Row="1" Margin="0,4,0,0" />
                    <TextBlock x:Name="ProcessHint" Grid.Row="1" Style="{StaticResource PerchCaption}" FontSize="11" Margin="0,4,0,0" Text="Measuring..." />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: CPU model, Windows build and uptime -->
        <TextBlock x:Name="FooterText" Grid.Row="3" Style="{StaticResource PerchCaption}" FontSize="10.5" Margin="4,2,4,0" />
    </Grid>
</core:IslandPage>
