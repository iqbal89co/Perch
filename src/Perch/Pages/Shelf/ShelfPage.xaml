<core:IslandPage x:Class="Perch.Pages.Shelf.ShelfPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core"
                 AllowDrop="True" Background="Transparent"
                 DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: caption and count on the left, actions on the right -->
        <DockPanel Margin="2,0,2,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenFolderButton" Style="{StaticResource PerchGhostButton}" Content="Open folder"
                        FontSize="12" Padding="10,5" Margin="0,0,6,0" ToolTip="Open the shelf folder" />
                <Button x:Name="ClearButton" Style="{StaticResource PerchGhostButton}" Content="Clear"
                        FontSize="12" Padding="10,5" ToolTip="Remove everything from the shelf" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Shelf" Style="{StaticResource PerchTitle}" FontSize="15" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PerchCaption}" Margin="0,1,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Body: the tiles, or the empty drop zone -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="TileScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <WrapPanel x:Name="Tiles" />
            </ScrollViewer>

            <Grid x:Name="EmptyState" Visibility="Collapsed">
                <Rectangle RadiusX="16" RadiusY="16" Margin="2" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{DynamicResource IslandSubtle}" Opacity="0.6" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="30"
                               HorizontalAlignment="Center" Foreground="{DynamicResource IslandAccent}" />
                    <TextBlock Text="Drop files here" Style="{StaticResource PerchTitle}" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="They stay on your shelf until you drag them out or remove them"
                               Style="{StaticResource PerchCaption}" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Highlight while a drag is over the page -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
            <Border CornerRadius="16" Background="{DynamicResource IslandAccentSoft}" />
            <Rectangle RadiusX="16" RadiusY="16" Margin="3" StrokeThickness="2" StrokeDashArray="6 4"
                       Stroke="{DynamicResource IslandAccent}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           HorizontalAlignment="Center" Foreground="{DynamicResource IslandAccent}" />
                <TextBlock Text="Drop to keep it here" Style="{StaticResource PerchTitle}" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</core:IslandPage>
