<core:IslandPage x:Class="Perch.Pages.Today.TodayPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: the big date and how far through the day we are -->
        <Border Style="{StaticResource PerchCard}" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="WeekdayText" Style="{StaticResource PerchCaption}" FontSize="13" Foreground="{DynamicResource IslandAccent}" FontWeight="SemiBold" />
                <TextBlock x:Name="DayText" Style="{StaticResource PerchTitle}" FontSize="54" FontWeight="Bold" Margin="0,-4,0,-6" />
                <TextBlock x:Name="MonthText" Style="{StaticResource PerchBody}" FontSize="15" />
                <TextBlock x:Name="WeekText" Style="{StaticResource PerchCaption}" Margin="0,2,0,14" />
                <Grid Height="6">
                    <Border CornerRadius="3" Background="{DynamicResource IslandCardHover}" />
                    <Border x:Name="DayBar" CornerRadius="3" Background="{DynamicResource IslandAccent}" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <TextBlock x:Name="DayProgressText" Style="{StaticResource PerchCaption}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Right: the month -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="2,0,0,4">
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource PerchIconButton}" Content="&#xE76C;" Width="28" Height="28" FontSize="11" ToolTip="Next month" />
                <Button x:Name="TodayButton" DockPanel.Dock="Right" Style="{StaticResource PerchIconButton}" Content="&#xE8D1;" Width="28" Height="28" FontSize="12" ToolTip="Back to today" />
                <Button x:Name="PrevButton" DockPanel.Dock="Right" Style="{StaticResource PerchIconButton}" Content="&#xE76B;" Width="28" Height="28" FontSize="11" ToolTip="Previous month" />
                <TextBlock x:Name="MonthTitle" Style="{StaticResource PerchTitle}" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>
            <UniformGrid x:Name="Headers" Grid.Row="1" Columns="7" Margin="0,0,0,2" />
            <UniformGrid x:Name="Days" Grid.Row="2" Columns="7" Rows="6" />
        </Grid>
    </Grid>
</core:IslandPage>
