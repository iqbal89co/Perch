<core:IslandPage x:Class="Perch.Pages.AiUsage.AiUsagePage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: how fresh the numbers are, and the settings toggle -->
        <DockPanel>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource PerchIconButton}"
                    Content="&#xE713;" Width="26" Height="26" FontSize="12" ToolTip="AI settings" />
            <TextBlock x:Name="HeaderText" Style="{StaticResource PerchCaption}" VerticalAlignment="Center" Margin="4,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <!-- Three tiles side by side: the 5-hour window, the last 7 days, the last 7 days of Fable -->
            <Grid x:Name="UsageList">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- No Claude Code logs on this PC -->
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PerchGlyph}" Text="&#xE99A;" FontSize="30"
                           Foreground="{DynamicResource IslandAccent}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource PerchBody}" Text="No Claude Code logs found" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource PerchCaption}" Margin="0,3,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Text="Perch reads Claude Code's usage logs on this PC." />
            </StackPanel>

            <!-- Settings view -->
            <Border x:Name="SettingsPanel" Style="{StaticResource PerchCard}" Padding="14,10" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="BudgetHint" DockPanel.Dock="Right" Style="{StaticResource PerchCaption}"
                                   Foreground="{DynamicResource IslandDanger}" VerticalAlignment="Center"
                                   Text="Try 2.5M or 800k" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource PerchBody}" Text="Budgets" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource PerchCaption}" Margin="0,1,0,6"
                               Text="Input and output tokens, for example 2.5M or 800k. Leave empty for no bar." />

                    <!-- One column per row of the main view -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PerchCaption}" Text="Usage 5h" Margin="2,0,0,3" />
                        <TextBox x:Name="Budget5hBox" Grid.Row="1" Style="{StaticResource PerchTextBox}" Height="30"
                                 Background="{DynamicResource IslandCardHover}" ToolTip="Tokens per 5-hour window" />

                        <TextBlock Grid.Column="2" Style="{StaticResource PerchCaption}" Text="Usage Weekly" Margin="2,0,0,3" />
                        <TextBox x:Name="BudgetWeekBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource PerchTextBox}" Height="30"
                                 Background="{DynamicResource IslandCardHover}" ToolTip="Tokens in the last 7 days, all models" />

                        <TextBlock Grid.Column="4" Style="{StaticResource PerchCaption}" Text="Usage Fable" Margin="2,0,0,3" />
                        <TextBox x:Name="BudgetFableBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource PerchTextBox}" Height="30"
                                 Background="{DynamicResource IslandCardHover}" ToolTip="Fable tokens in the last 7 days" />
                    </Grid>

                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PerchCaption}" Text="Warn at" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button x:Name="NearLowerButton" Style="{StaticResource PerchGhostButton}" Content="&#x2212;"
                                    Width="28" Height="26" Padding="0" />
                            <TextBlock x:Name="NearText" Style="{StaticResource PerchBody}" Width="44" TextAlignment="Center"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button x:Name="NearHigherButton" Style="{StaticResource PerchGhostButton}" Content="+"
                                    Width="28" Height="26" Padding="0" />
                        </StackPanel>
                        <CheckBox x:Name="WarnToggle" Style="{StaticResource PerchToggle}" Content="Tell me before I run out"
                                  VerticalAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="RescanButton" DockPanel.Dock="Right" Style="{StaticResource PerchGhostButton}"
                                Content="Rescan now" Padding="12,5" />
                        <TextBlock Style="{StaticResource PerchCaption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="Perch reads only token counts and times from Claude Code's local logs. Nothing leaves this PC." />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</core:IslandPage>
