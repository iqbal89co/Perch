<core:IslandPage x:Class="Perch.Pages.Prayer.PrayerPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core">
    <core:IslandPage.Resources>
        <!-- A ghost button whose text sits at the left, for the city list. -->
        <Style x:Key="PlaceButton" TargetType="Button" BasedOn="{StaticResource PerchGhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandCardHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </core:IslandPage.Resources>
    <Grid>
        <!-- Day view: header, next prayer with progress, eight times, and a strip of facts -->
        <Grid x:Name="DayView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                        Style="{StaticResource PerchIconButton}" Content="&#xE713;" ToolTip="Prayer settings" />
                <StackPanel>
                    <TextBlock x:Name="PlaceText" Style="{StaticResource PerchTitle}" FontSize="16" />
                    <TextBlock x:Name="DateText" Style="{StaticResource PerchCaption}" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Next prayer, with how far we are since the previous one -->
                <Border Style="{StaticResource PerchCard}" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXT PRAYER" Style="{StaticResource PerchCaption}" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource IslandAccent}" />
                            <TextBlock x:Name="NextNameText" Style="{StaticResource PerchTitle}" FontSize="20" Margin="0,2,0,0" />
                            <TextBlock x:Name="NextTimeText" Style="{StaticResource PerchTitle}" FontSize="32"
                                       FontWeight="Bold" Margin="0,-4,0,0" />
                            <TextBlock x:Name="NextCountdownText" Style="{StaticResource PerchBody}" FontSize="12.5"
                                       Margin="0,2,0,0" Foreground="{DynamicResource IslandAccent}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Grid x:Name="ProgressTrack" Height="4" Margin="0,0,0,4">
                                <Border CornerRadius="2" Background="{DynamicResource IslandStroke}" />
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"
                                        Background="{DynamicResource IslandAccent}" />
                            </Grid>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource PerchCaption}" FontSize="10.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Eight times in a 4 x 2 grid; the current period is highlighted, passed ones are dimmed -->
                <UniformGrid x:Name="TilesGrid" Grid.Column="2" Columns="4" Rows="2" />
            </Grid>

            <!-- Facts strip: night, day length, qibla, next Islamic date -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource PerchGlyph}" Text="&#xE708;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock x:Name="NightText" Style="{StaticResource PerchCaption}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource PerchGlyph}" Text="&#xE706;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock x:Name="DayLengthText" Style="{StaticResource PerchCaption}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource PerchGlyph}" Text="&#xE787;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock x:Name="IslamicText" Style="{StaticResource PerchCaption}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="QiblaPanel" Orientation="Horizontal">
                    <Viewbox Width="36" Height="36" Margin="0,0,6,0" ToolTip="Direction of the Kaaba from here">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="{DynamicResource IslandCard}" Stroke="{DynamicResource IslandStroke}" StrokeThickness="1" />
                            <Grid x:Name="QiblaNeedle" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="QiblaRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <Polygon Points="28,5 33,28 28,31 23,28" Fill="{DynamicResource IslandAccent}" />
                            </Grid>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource IslandForeground}" />
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="QiblaText" Style="{StaticResource PerchCaption}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Settings view: city, method, reminders -->
        <Grid x:Name="SettingsView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- City picker -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CityHeading" Style="{StaticResource PerchTitle}" FontSize="14" Margin="0,0,0,6" />
                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource PerchTextBox}" Margin="0,0,0,6"
                         ToolTip="Search a city or country" />

                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <Button x:Name="LocateButton" Style="{StaticResource PerchGhostButton}" Height="30"
                            Content="Use my location" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="LocationText" Style="{StaticResource PerchCaption}" Margin="2,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PlacesPanel" Margin="0,0,8,0" />
                </ScrollViewer>
            </Grid>

            <!-- Settings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource PerchButton}"
                            Content="Done" Padding="16,5" Margin="8,0,0,0" />
                    <TextBlock x:Name="SettingsHeading" Style="{StaticResource PerchTitle}" FontSize="14"
                               VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Grid.Row="1">
                    <DockPanel Height="28" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="MethodPrev" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76B;" />
                            <TextBlock x:Name="MethodValue" Width="168" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PerchBody}" />
                            <Button x:Name="MethodNext" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76C;" />
                        </StackPanel>
                        <TextBlock Text="Calculation" Style="{StaticResource PerchBody}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DockPanel Height="28" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="AsrPrev" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76B;" />
                            <TextBlock x:Name="AsrValue" Width="168" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PerchBody}" />
                            <Button x:Name="AsrNext" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76C;" />
                        </StackPanel>
                        <TextBlock Text="Asr" Style="{StaticResource PerchBody}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DockPanel Height="28" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="RemindPrev" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76B;" />
                            <TextBlock x:Name="RemindValue" Width="168" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PerchBody}" />
                            <Button x:Name="RemindNext" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76C;" />
                        </StackPanel>
                        <TextBlock Text="Remind me before" Style="{StaticResource PerchBody}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DockPanel Height="28" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="SoundPrev" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76B;" />
                            <TextBlock x:Name="SoundValue" Width="168" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PerchBody}" />
                            <Button x:Name="SoundNext" Style="{StaticResource PerchIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE76C;" />
                        </StackPanel>
                        <TextBlock Text="Sound" Style="{StaticResource PerchBody}" VerticalAlignment="Center" />
                    </DockPanel>

                    <CheckBox x:Name="PauseToggle" Style="{StaticResource PerchToggle}" Content="Pause music at prayer time" Height="28" Margin="0,0,0,4" />
                    <CheckBox x:Name="NotifyToggle" Style="{StaticResource PerchToggle}" Content="Notify me when it is time" Height="28" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</core:IslandPage>
