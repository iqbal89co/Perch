<core:IslandPage x:Class="Perch.Pages.Tasks.TasksPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Perch.Core">
    <core:IslandPage.Resources>
        <!-- Filled accent "+" button -->
        <Style x:Key="TaskAddButton" TargetType="Button" BasedOn="{StaticResource PerchIconButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource IslandAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandOnAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round action on a row (move up/down, delete) -->
        <Style x:Key="TaskActionButton" TargetType="Button" BasedOn="{StaticResource PerchIconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandCardHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row in the list: 34 DIPs, lights up on hover -->
        <Style x:Key="TaskRow" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </core:IslandPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Input row -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="InputBox" Style="{StaticResource PerchTextBox}" Height="34" MaxLength="200" />
                <TextBlock x:Name="Placeholder" Text="Add a task and press Enter" Style="{StaticResource PerchCaption}"
                           FontSize="13" Margin="11,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource TaskAddButton}" Content="&#xE710;"
                    Margin="8,0,0,0" ToolTip="Add task" />
        </Grid>

        <!-- The list -->
        <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel x:Name="ListPanel" />
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource IslandCard}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource PerchGlyph}" Text="&#xE73E;" FontSize="22"
                           Foreground="{DynamicResource IslandAccent}" />
            </Border>
            <TextBlock Text="Nothing to do" Style="{StaticResource PerchTitle}" HorizontalAlignment="Center" Margin="0,10,0,2" />
            <TextBlock Text="Add something above" Style="{StaticResource PerchCaption}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Footer -->
        <DockPanel x:Name="FooterPanel" Grid.Row="2" Margin="2,8,0,0">
            <Button x:Name="ClearDoneButton" DockPanel.Dock="Right" Style="{StaticResource PerchGhostButton}"
                    Content="Clear done" Padding="10,4" FontSize="11.5" Visibility="Collapsed" />
            <TextBlock x:Name="CountText" Style="{StaticResource PerchCaption}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</core:IslandPage>
